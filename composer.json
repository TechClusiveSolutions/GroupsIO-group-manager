{
    "name": "techclusivesolutions/groupsio-group-manager",
    "description": "Automates BITS Groups.io mailing list membership from Paid Memberships Pro status.",
    "type": "wordpress-plugin",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.0",
        "woocommerce/action-scheduler": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "composer/installers": "^2.0",
        "strangerstudios/paid-memberships-pro": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "BITS\\GroupsIOSync\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BITS\\GroupsIOSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true
        }
    },
    "extra": {
        "installer-paths": {
            "vendor/wordpress-plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    }
}
