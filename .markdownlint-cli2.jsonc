{
    // Line-length (MD013) is deliberately disabled: this project's docs use
    // long-line prose paragraphs rather than hard-wrapped text, per
    // CLAUDE.md's linear/hierarchical, screen-reader-friendly style
    // guidance — hard-wrapping would not improve non-visual readability
    // and would just add noisy diffs.
    "config": {
        "MD013": false,
        // CHANGELOG.md (Keep a Changelog format) repeats headings like
        // "### Added"/"### Fixed" under every dated version section by
        // design — only flag duplicates within the same parent section,
        // not across different ones.
        "MD024": {
            "siblings_only": true
        }
    },
    "globs": [
        "**/*.md"
    ],
    "ignores": [
        "vendor/**",
        "node_modules/**"
    ]
}
