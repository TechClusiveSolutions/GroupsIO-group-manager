<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="tests/integration-bootstrap.php"
    colors="true"
    beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="integration">
            <directory suffix="Test.php">./tests/integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
